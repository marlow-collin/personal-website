{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "main": "src/index.js",
  "compatibility_date": "2026-09-09",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/x/date/*",
      "/x/api/*",
      "/x/admin/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-website-date-invitations",
      "database_id": "5e9cdc4a-99c8-4235-9a2d-e0f08d855de5",
      "migrations_dir": "migrations"
    },
    {
      "binding": "DAILY_DB",
      "database_name": "personal-website-daily-content",
      "database_id": "2d2780c2-be82-4510-bf3e-dfcd00dd9793",
      "migrations_dir": "migrations/daily"
    },
    {
      "binding": "CHECKIN_DB",
      "database_name": "personal-website-personal-checkins",
      "database_id": "6595dfba-3be7-40d5-9854-ebae02d57cb5",
      "migrations_dir": "migrations/checkins"
    },
    {
      "binding": "CONVERSATION_DB",
      "database_name": "personal-website-conversation-content",
      "database_id": "cea7065e-e57e-444c-a605-3f2a518b3418",
      "migrations_dir": "migrations/conversation"
    }
  ],
  "secrets": {
    "required": [
      "DATE_EMAIL_DESTINATION",
      "IONOS_SMTP_USER",
      "IONOS_SMTP_PASSWORD"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "marlow-rischmueller.com",
      "custom_domain": true
    },
    {
      "pattern": "www.marlow-rischmueller.com",
      "custom_domain": true
    }
  ]
}
